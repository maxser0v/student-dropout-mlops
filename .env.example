# Loaded by scripts/run_demo.py automatically; no copy step or secrets needed.
# On a fresh machine the dashboard uses 127.0.0.1:5000; if busy, the runner
# automatically chooses another available loopback port.
DEMO_MLFLOW_PORT=5000
DOCKER_PLATFORM=linux/arm64
RUNTIME_UID=auto
RUNTIME_GID=auto
METAFLOW_USER=student-mlops
